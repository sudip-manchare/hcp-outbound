# =============================================================
# Tiger Data / PostgreSQL Connection
# =============================================================
# Paste your Tiger Data connection string here.
# Format: postgresql+asyncpg://user:password@host:port/dbname
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:PORT/DBNAME

# Sync version used only for init/seed scripts (psycopg2)
DATABASE_URL_SYNC=postgresql://USER:PASSWORD@HOST:PORT/DBNAME

# =============================================================
# App settings
# =============================================================
APP_ENV=development
# JSON array of frontend origins, including scheme; no trailing slash or path.
CORS_ORIGINS=["http://localhost:3000"]
SECRET_KEY=change-me-in-production

# Server-only Gemini credentials for Explain this record.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_SECONDS=30

# =============================================================
# Official public data APIs (no API key is required)
# =============================================================
# Live NPI Registry lookup. Do not replace this with fixture data.
NPPES_API_BASE_URL=https://npiregistry.cms.hhs.gov/api/
NPPES_API_VERSION=2.1

# CMS Open Payments datastore query API. CMS changes the dataset ID when it
# publishes a new program year; update both values together after verifying
# the new ID in https://openpaymentsdata.cms.gov/data.json.
CMS_OPEN_PAYMENTS_API_BASE_URL=https://openpaymentsdata.cms.gov/api/1
CMS_OPEN_PAYMENTS_GENERAL_DATASET_ID=fb0b1734-1410-429d-92f6-3f4b35218e5e
CMS_OPEN_PAYMENTS_PROGRAM_YEAR=2025
EXTERNAL_API_TIMEOUT_SECONDS=30
CMS_OPEN_PAYMENTS_MAX_PAGE_SIZE=100
